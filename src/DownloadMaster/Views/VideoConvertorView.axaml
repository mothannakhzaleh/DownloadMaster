<UserControl x:Class="DownloadMaster.Views.VideoConvertorView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             DragDrop.AllowDrop="True">
    <UserControl.Styles>
        <Style Selector="Border.card.dragover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="RadioButton TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,12,*,12,260" MaxHeight="540">

            <!-- Source -->
            <Border Grid.Column="0" Classes="card" MinWidth="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="VideoSourceTitle" Classes="h2" Text="Video source" Margin="0,0,0,4" />
                        <TextBlock x:Name="VideoSourceHint" Classes="secondary" FontSize="12" Margin="0,0,0,12"
                                   Text="Single video file only" />

                        <TextBlock x:Name="VideoFileLabel" Classes="field" Text="Video file" />
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                            <TextBox x:Name="VideoInputPathBox" IsReadOnly="True" />
                            <Button x:Name="VideoBrowseInputButton" Grid.Column="1" Classes="secondary"
                                    Content="Browse" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock x:Name="VideoOperationLabel" Classes="field" Text="Operation" />
                        <StackPanel Spacing="2" Margin="0,0,0,12">
                            <RadioButton x:Name="VideoConvertRadio" GroupName="VideoOperation" IsChecked="True">
                                <TextBlock x:Name="VideoConvertRadioText" Text="Convert — change to another format" />
                            </RadioButton>
                            <RadioButton x:Name="VideoOptimizeRadio" GroupName="VideoOperation">
                                <TextBlock x:Name="VideoOptimizeRadioText" Text="Optimize — re-encode and overwrite same format" />
                            </RadioButton>
                            <RadioButton x:Name="VideoToGifRadio" GroupName="VideoOperation">
                                <TextBlock x:Name="VideoToGifRadioText" Text="To GIF — animated GIF from video" />
                            </RadioButton>
                            <RadioButton x:Name="VideoToFramesRadio" GroupName="VideoOperation">
                                <TextBlock x:Name="VideoToFramesRadioText" Text="To frame textures — extract image sequence" />
                            </RadioButton>
                        </StackPanel>

                        <StackPanel x:Name="VideoFormatPanel">
                            <TextBlock x:Name="VideoFormatLabel" Classes="field" Text="Target format" />
                            <ComboBox x:Name="VideoFormatCombo" HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel x:Name="VideoGifOptionsPanel" IsVisible="False" Margin="0,8,0,0">
                            <TextBlock x:Name="GifFpsLabel" Classes="field" Text="GIF frame rate (FPS)" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Slider x:Name="GifFpsSlider" Minimum="1" Maximum="30" Value="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" MinWidth="24" Margin="12,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding #GifFpsSlider.Value, StringFormat={}{0:0}}" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="VideoFrameOptionsPanel" IsVisible="False" Margin="0,8,0,0">
                            <TextBlock x:Name="FrameFormatLabel" Classes="field" Text="Frame image format" />
                            <ComboBox x:Name="FrameFormatCombo" SelectedIndex="0" HorizontalAlignment="Stretch">
                                <ComboBoxItem x:Name="FramePngItem" Content="PNG (recommended)" Tag="Png" />
                                <ComboBoxItem Content="JPEG" Tag="Jpg" />
                                <ComboBoxItem Content="BMP" Tag="Bmp" />
                                <ComboBoxItem Content="TGA" Tag="Tga" />
                            </ComboBox>

                            <TextBlock x:Name="FrameExtractLabel" Classes="field" Text="Extract mode" Margin="0,10,0,6" />
                            <RadioButton x:Name="EveryFrameRadio" GroupName="FrameExtract" IsChecked="True">
                                <TextBlock x:Name="EveryFrameRadioText" Text="Every frame" />
                            </RadioButton>
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,8">
                                <RadioButton x:Name="TargetFpsFrameRadio" GroupName="FrameExtract" VerticalAlignment="Center">
                                    <TextBlock x:Name="TargetFpsFrameRadioText" Text="Target FPS:" />
                                </RadioButton>
                                <Slider x:Name="FrameFpsSlider" Grid.Column="1" Margin="8,0" Minimum="1" Maximum="60" Value="12"
                                        TickFrequency="1" IsSnapToTickEnabled="True" IsEnabled="False"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" MinWidth="24" VerticalAlignment="Center"
                                           Text="{Binding #FrameFpsSlider.Value, StringFormat={}{0:0}}" />
                            </Grid>
                            <TextBlock x:Name="FramesHintText" Classes="secondary" FontSize="11" TextWrapping="Wrap"
                                       Text="Creates a folder of numbered frames (frame_0001.png, …) for textures or sprites." />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Output -->
            <Border Grid.Column="2" Classes="card" MinWidth="240">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock x:Name="VideoOutputTitle" Classes="h2" Text="Output" Margin="0,0,0,12" />

                        <TextBlock x:Name="VideoSaveToLabel" Classes="field" Text="Save to" />
                        <StackPanel Spacing="2" Margin="0,0,0,10">
                            <RadioButton x:Name="VideoSameFolderRadio" GroupName="VideoOutput" IsChecked="True">
                                <TextBlock x:Name="VideoSameFolderRadioText" Text="Same folder (optimize in place or replace extension)" />
                            </RadioButton>
                            <RadioButton x:Name="VideoCustomFolderRadio" GroupName="VideoOutput">
                                <TextBlock x:Name="VideoCustomFolderRadioText" Text="Custom output folder" />
                            </RadioButton>
                        </StackPanel>

                        <Grid x:Name="VideoOutputFolderPanel" ColumnDefinitions="*,Auto" Margin="0,0,0,12" IsEnabled="False">
                            <TextBox x:Name="VideoOutputFolderBox" IsReadOnly="True" />
                            <Button x:Name="VideoBrowseOutputButton" Grid.Column="1" Classes="secondary"
                                    Content="Browse" Margin="10,0,0,0" />
                        </Grid>

                        <TextBlock x:Name="VideoResolutionLabel" Classes="field" Text="Resolution" />
                        <ComboBox x:Name="VideoResolutionCombo" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" Classes="secondary" Margin="16,0,0,0"
                                                   Text="{Binding DimensionsText}" />
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock x:Name="VideoOperationHint" Classes="secondary" FontSize="12" TextWrapping="Wrap"
                                   Text="Convert re-encodes the video into the selected container and codec." />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Info / drop zone -->
            <Border x:Name="VideoInfoDropZone" Grid.Column="4" Classes="card">
                <StackPanel>
                    <TextBlock x:Name="VideoInfoTitle" Classes="h2" Text="Video info" Margin="0,0,0,10" />
                    <Border Classes="elevated" MinHeight="130" Margin="0,0,0,10"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="VideoInfoTitleText" Text="Drop a video file" FontWeight="SemiBold"
                                       FontSize="12" TextWrapping="Wrap" />
                            <SelectableTextBlock x:Name="VideoInfoDetails" Classes="secondary" FontSize="11"
                                                 TextWrapping="Wrap" Margin="0,6,0,0"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 Text="Codec, resolution, duration, and size appear here." />
                            <TextBlock x:Name="VideoFfmpegStatus" Classes="secondary" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="VideoSupportedLabel" Classes="field" Text="Supported inputs" />
                    <TextBlock x:Name="VideoSupportedText" Classes="secondary" FontSize="11" TextWrapping="Wrap"
                               Text="MP4, MKV, WebM, AVI, MOV, WMV, FLV, MPEG, M4V, TS, 3GP, OGV, ASF, and more." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Result -->
        <Border Grid.Row="1" Classes="card" Margin="0,12">
            <Grid RowDefinitions="Auto,Auto,Auto,*" MinHeight="100">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Name="VideoResultsTitle" Classes="h2" Text="Video result" />
                    <TextBlock x:Name="VideoResultsSummaryText" Grid.Column="1" Classes="secondary" FontSize="12"
                               VerticalAlignment="Center" TextWrapping="Wrap" Text="No conversion yet" />
                </Grid>
                <ProgressBar x:Name="VideoResultsProgressBar" Grid.Row="1" Margin="0,10,0,4"
                             Minimum="0" Maximum="100" Value="0" IsVisible="False" />

                <Grid x:Name="VideoResultsHeader" Grid.Row="2" ColumnDefinitions="90,2*,2*,3*" Margin="4,10,4,6">
                    <TextBlock x:Name="VideoResultStatusCol" Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="Status" />
                    <TextBlock x:Name="VideoResultFileCol" Grid.Column="1" Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="File" />
                    <TextBlock x:Name="VideoResultSizeCol" Grid.Column="2" Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="Size change" />
                    <TextBlock x:Name="VideoResultDetailsCol" Grid.Column="3" Classes="secondary" FontSize="12" FontWeight="SemiBold" Text="Details" />
                </Grid>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="VideoResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="4,8">
                                    <Grid ColumnDefinitions="90,2*,2*,3*">
                                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Classes.success="{Binding IsSuccess}"
                                                   Classes.error="{Binding IsFailed}" />
                                        <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding SourcePath}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding SizeChange}" TextWrapping="Wrap"
                                                   Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <SelectableTextBlock Grid.Column="3" Text="{Binding Detail}" TextWrapping="Wrap"
                                                             VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="VideoStatusText" Text="Ready" FontSize="13" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="VideoProgressBar" Margin="0,8,16,0" Minimum="0" Maximum="100" Value="0"
                             IsVisible="False" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                <Button x:Name="VideoCancelButton" Classes="secondary" Content="Cancel" IsVisible="False" />
                <Button x:Name="VideoClearResultsButton" Classes="secondary" Content="Clear result" />
                <Button x:Name="VideoConvertButton" Classes="primary" Content="Convert video" MinWidth="140" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
