{
  "manifest_version": 3,
  "name": "DownloadMaster",
  "short_name": "DownloadMaster",
  "version": "2.0.0",
  "description": "Send browser downloads and videos to the DownloadMaster desktop app, with cookies and headers included.",
  "homepage_url": "https://github.com/mothannakhzaleh/DownloadMaster",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "cookies", "webRequest", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "action": {
    "default_title": "DownloadMaster",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
