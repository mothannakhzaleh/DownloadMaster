<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DownloadMaster.BatchDownloadWindow"
        Title="Batch download"
        Icon="/Assets/app.ico"
        Width="640" Height="520"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Margin="24,24,24,12" Spacing="10">
            <TextBlock x:Name="HeaderText" Text="Batch download" Classes="h2" />
            <TextBlock x:Name="HintText" TextWrapping="Wrap" Classes="secondary" FontSize="13" />
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="PatternBox" TextChanged="PatternBox_TextChanged" />
                <Button x:Name="PreviewButton" Grid.Column="1" Content="Preview" Classes="secondary"
                        Margin="10,0,0,0" Click="PreviewButton_Click" />
            </Grid>
            <TextBlock x:Name="CountText" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Classes="elevated" Margin="24,0,24,12">
            <ListBox x:Name="PreviewList" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="Cancel" Classes="secondary" Margin="0,0,10,0"
                        IsCancel="True" Click="CancelButton_Click" />
                <Button x:Name="QueueButton" Content="Download all" Classes="primary" IsEnabled="False"
                        Click="QueueButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
